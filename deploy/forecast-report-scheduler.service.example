# 示例模板：下列 /home/k8s/... 路径来自另一台 Linux 部署机，
# 复制到 /etc/systemd/system/ 后必须改成实际的项目目录与用户。
[Unit]
Description=Ocean Mining automatic forecast report scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=k8s
WorkingDirectory=/home/k8s/workspace/Ocean_Mining_System_0824
EnvironmentFile=/home/k8s/workspace/Ocean_Mining_System_0824/scripts/forecast-report-scheduler.env
ExecStart=/usr/bin/node /home/k8s/workspace/Ocean_Mining_System_0824/scripts/forecast-report-scheduler.mjs --watch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
