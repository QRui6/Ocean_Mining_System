{
  "name": "ship-monitoring-backend",
  "version": "1.0.0",
  "description": "船舶区域监控后端服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "psql -U postgres -f database_postgres.sql",
    "init-db-docker": "docker exec -i postgres_container psql -U postgres < database_postgres.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.14.2",
    "axios": "^1.6.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
